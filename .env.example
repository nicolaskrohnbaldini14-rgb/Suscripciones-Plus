# Variables de entorno de la aplicación y de la base de datos.
# Copiá este archivo como .env y cambiá los valores que quieras:
#   cp .env.example .env
# (make run-app lo copia solo si .env no existe). El .env NO se sube al repo.

# Credenciales de PostgreSQL (las usan docker-compose.yml y la aplicación)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mi_tp2_db

# Dónde escucha la base (puerto publicado por Docker en la máquina)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Usuarios de prueba: para entrar y probar la app sin registrarse.
# Al iniciar, la app crea estas cuentas (si no existen) y le carga a cada una
# varias suscripciones de ejemplo: en el mes actual, el anterior (se renueva
# sola) y el siguiente, con y sin cuenta, servicios del hogar y seguros, dos
# cuentas del mismo servicio y algunas pausadas.
# Formato: nombre|email|contraseña  (se pueden agregar USUARIO_PRUEBA_4, 5...)
# Para no cargarlas: CARGAR_USUARIOS_DE_PRUEBA=false
# ---------------------------------------------------------------------------
CARGAR_USUARIOS_DE_PRUEBA=true
USUARIO_PRUEBA_1=Martina|martina@ejemplo.com|martina123
USUARIO_PRUEBA_2=Agustina|agustina@ejemplo.com|agustina123
USUARIO_PRUEBA_3=Nicolás|nicolas@ejemplo.com|nicolas123
