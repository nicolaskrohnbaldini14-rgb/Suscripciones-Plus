# Variables de entorno de la aplicación y de la base de datos.
# Copiá este archivo como .env y cambiá los valores que quieras:
#   cp .env.example .env
# (make run-app lo copia solo si .env no existe). El .env NO se sube al repo.

# Credenciales de PostgreSQL (las usan docker-compose.yml y la aplicación)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mi_tp2_db

# Dónde escucha la base (puerto publicado por Docker en la máquina)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
