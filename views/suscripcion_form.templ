package views

import (
	"strconv"

	"tp2-krohn-trapani-cicopiedi/db/sqlc"
)

// FormSuscripcion guarda lo que ingresó el usuario para no perderlo si hay un
// error (la contraseña de la cuenta no se vuelve a mostrar)
type FormSuscripcion struct {
	IDServicio       int32
	Monto            string
	FechaInicio      string
	FechaVencimiento string
	UsuarioCuenta    string
}

templ NuevaSuscripcionPage(p Pagina, form FormSuscripcion) {
	@Layout(p, contenidoNuevaSuscripcion(p.Servicios, form))
}

templ contenidoNuevaSuscripcion(servicios []sqlc.Servicio, form FormSuscripcion) {
	<h1>Nueva suscripción</h1>
	<section class="panel">
		@SuscripcionForm(servicios, form)
	</section>
	<p><a href="/cuenta/suscripciones">← Volver a mis suscripciones</a></p>
}

// IDFormularioSuscripcion es el id del formulario de nueva suscripción: los
// botones del catálogo lo usan para elegir el servicio sin perder lo escrito
const IDFormularioSuscripcion = "form-suscripcion"

// SuscripcionForm crea una suscripción para el usuario que inició sesión
// (el usuario sale de la sesión y el estado inicial es siempre Activa)
templ SuscripcionForm(servicios []sqlc.Servicio, form FormSuscripcion) {
	if len(servicios) == 0 {
		<p class="vacio">Todavía no hay servicios disponibles.</p>
	} else {
		<form id={ IDFormularioSuscripcion } method="post" action="/cuenta/suscripciones" class="formulario formulario-grilla">
			// botón por defecto (invisible): Enter en un campo crea la suscripción,
			// no abre el catálogo, que es el primer botón del formulario
			<button type="submit" class="boton-por-defecto" tabindex="-1" aria-hidden="true">Crear suscripción</button>
			<label>
				Servicio
				// el servicio elegido viaja oculto; el botón abre el catálogo grande
				// (envía el formulario por POST, así no se pierde lo escrito y la
				// contraseña no queda en la URL)
				<input type="hidden" name="id_servicio" value={ strconv.Itoa(int(form.IDServicio)) }/>
				<button
					type="submit"
					formaction="/cuenta/suscripciones/nueva/catalogo"
					formmethod="post"
					formnovalidate
					class="selector-servicio"
				>
					if nombre := nombreServicio(servicios, form.IDServicio); nombre != "" {
						{ nombre }
					} else {
						Elegí un servicio
					}
				</button>
			</label>
			<label>
				Monto mensual
				// texto (no number): sin JavaScript no se puede cambiar el mensaje del
				// navegador ("El valor debe ser mayor o igual a 0.01"), así que valida
				// el servidor y avisa "Ingrese un monto válido" en el aviso negro
				<input type="text" inputmode="decimal" name="monto" value={ form.Monto } placeholder="Ej.: 4500.50" autocomplete="off" required autofocus?={ form.IDServicio != 0 }/>
			</label>
			<label>
				Fecha de inicio
				<input type="date" name="fecha_inicio" value={ form.FechaInicio } required/>
			</label>
			<label>
				Fecha de vencimiento
				<input type="date" name="fecha_vencimiento" value={ form.FechaVencimiento } required/>
			</label>
			<label>
				Usuario de la cuenta del servicio (opcional)
				<input type="text" name="usuario_cuenta" value={ form.UsuarioCuenta }/>
			</label>
			<label>
				Contraseña de la cuenta del servicio (opcional)
				<input type="password" name="password_cuenta"/>
			</label>
			<button type="submit">Crear suscripción</button>
		</form>
	}
}

// nombreServicio devuelve el nombre del servicio elegido ("" si no hay)
func nombreServicio(servicios []sqlc.Servicio, id int32) string {
	for _, s := range servicios {
		if s.IDServicio == id {
			return s.Nombre
		}
	}
	return ""
}
